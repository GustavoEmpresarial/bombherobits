{
  "name": "herobits",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @herobits/api dev",
    "dev:web": "pnpm --filter @herobits/web dev",
    "build": "pnpm -r run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @herobits/api db:migrate",
    "db:seed": "pnpm --filter @herobits/api db:seed",
    "db:generate": "pnpm --filter @herobits/api db:generate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1"
}
